# Dart 생성 파일(build_runner 산출물)은 LF로 고정한다.
# build_runner는 LF로 생성하지만 repo core.autocrlf=true가 CRLF를 기대해
# working tree에 매번 변경(M)으로 뜨는 노이즈가 발생한다. EOL을 LF로 못박아 해소한다.
# 일반 .dart는 기존 autocrlf 동작을 유지하도록 좁게 생성 파일만 지정한다.
*.freezed.dart text eol=lf
*.g.dart text eol=lf

# 이 JSON은 JS/Dart가 raw SHA-256으로 동일성을 검증하므로 checkout에서도 LF를 유지한다.
apps/web/lib/src/analytics/mission-spine.analytics.v1.json text eol=lf

# Raw SHA-256 inputs must have checkout-independent bytes.
pubspec.lock text eol=lf
evidence/et13/**/*.json text eol=lf
tool/release-evidence/**/*.json text eol=lf

# Monaco is vendored byte-for-byte from the pinned npm archive. Treat upstream
# minified assets/notices as binary so Git does not normalize or whitespace-check
# their exact bytes.
apps/web/web/vendor/monaco/vs/** -text -diff
apps/web/web/vendor/monaco/LICENSE text eol=lf
apps/web/web/vendor/monaco/ThirdPartyNotices.txt text eol=lf
